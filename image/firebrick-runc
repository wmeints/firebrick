#!/usr/bin/env python3
"""Stands in for runc as Docker's default runtime, so containers trust the TLS interception CA.

In a sandbox with TLS interception, microsandbox writes its CA to /.msb/tls/ca.pem and adds it
to the guest's system bundle, but a container has its own files and environment, so every HTTPS
request in it would fail the certificate check. On `create`, while /.msb/tls/ca.pem exists, this
edits the container's config.json: it mounts the guest's system bundle, and the Java trust store
fbkd builds when it exists, read-only into /etc/firebrick, points SSL_CERT_FILE,
REQUESTS_CA_BUNDLE, CURL_CA_BUNDLE and NODE_EXTRA_CA_CERTS at the bundle when the container
doesn't set them, and adds the trust store to JAVA_TOOL_OPTIONS unless that sets a store of its
own. A CA variable the image or `docker run -e` sets keeps its value, and a copy of the file it
names with the CA appended is mounted read-only over that file. It then runs runc with the same
arguments. A failed edit is reported on stderr, which ends up in /var/log/dockerd.log, and the
container starts without the CA (ADR 0068).
"""

import json
import os
import sys

RUNC = "/usr/bin/runc"
CA = "/.msb/tls/ca.pem"
BUNDLE = "/etc/ssl/certs/ca-certificates.crt"
STORE = "/etc/ssl/certs/java/firebrick.p12"
CONTAINER_BUNDLE = "/etc/firebrick/ca-certificates.crt"
CONTAINER_STORE = "/etc/firebrick/firebrick.p12"
BUNDLE_VARS = ("SSL_CERT_FILE", "REQUESTS_CA_BUNDLE", "CURL_CA_BUNDLE", "NODE_EXTRA_CA_CERTS")
JAVA_VAR = "JAVA_TOOL_OPTIONS"
MAX_LINKS = 40
TRUST_STORE_PROPERTY = "-Djavax.net.ssl.trustStore="
TRUST_STORE_OPTIONS = (
    f"{TRUST_STORE_PROPERTY}{CONTAINER_STORE} -Djavax.net.ssl.trustStorePassword=changeit"
)


def bundle_dir(args):
    """Returns the bundle directory of a `create` command, or None for other commands."""
    if "create" not in args:
        return None
    rest = args[args.index("create") + 1:]
    for i, arg in enumerate(rest):
        if arg in ("--bundle", "-b") and i + 1 < len(rest):
            return rest[i + 1]
        for prefix in ("--bundle=", "-b="):
            if arg.startswith(prefix):
                return arg[len(prefix):]
    return "."


def mount(source, destination):
    return {"destination": destination, "type": "bind", "source": source,
            "options": ["rbind", "ro", "nosuid", "nodev"]}


def with_java_options(value):
    """Returns the value with the trust store options at its end, unless it sets a store."""
    if value is None or not value.strip():
        return TRUST_STORE_OPTIONS
    if TRUST_STORE_PROPERTY in value:
        return value
    return f"{value.strip()} {TRUST_STORE_OPTIONS}"


def container_file(rootfs, path):
    """Returns the path of the container's regular file at the absolute `path`, with its
    symlinks resolved as the container sees them: an absolute target starts at the root
    filesystem, and `..` stops there. Returns None when there is no such file."""
    if not os.path.isabs(path):
        return None
    parts = path.split("/")
    resolved = []
    links = 0
    while parts:
        part = parts.pop(0)
        if part in ("", "."):
            continue
        if part == "..":
            resolved = resolved[:-1]
            continue
        current = os.path.join(rootfs, *resolved, part)
        if not os.path.islink(current):
            resolved.append(part)
            continue
        links += 1
        if links > MAX_LINKS:
            return None
        target = os.readlink(current)
        resolved = [] if target.startswith("/") else resolved
        parts = target.split("/") + parts
    file = "/" + "/".join(resolved)
    return file if os.path.isfile(os.path.join(rootfs, *resolved)) else None


def merged_bundle(bundle, rootfs, path, mounts):
    """Mounts a copy of the container's bundle at `path` with the CA appended over it, and
    returns whether it could. A file that is mounted already is merged only once."""
    file = container_file(rootfs, path)
    if file is None:
        return False
    if any(mount["destination"] == file for mount in mounts):
        return True
    with open(os.path.join(rootfs, file.lstrip("/")), "rb") as source:
        own = source.read()
    with open(CA, "rb") as source:
        ca = source.read()
    merged = os.path.join(bundle, f"firebrick-ca-{len(mounts)}.pem")
    with open(merged, "wb") as target:
        target.write(own if own.endswith(b"\n") or not own else own + b"\n")
        target.write(ca)
    os.chmod(merged, 0o644)
    mounts.append(mount(merged, file))
    return True


def trust_ca(config, bundle):
    """Adds the mounts and variables that let the container trust the interception CA. A CA
    variable the container sets keeps its value, and the file it names gets the CA appended;
    when the container has no such file, the variable points at the guest's bundle instead."""
    mounts = config.setdefault("mounts", [])
    process = config.setdefault("process", {})
    env = process.setdefault("env", [])
    rootfs = os.path.join(bundle, config.get("root", {}).get("path", "rootfs"))
    names = {var.split("=", 1)[0]: i for i, var in enumerate(env)}

    mounts.append(mount(BUNDLE, CONTAINER_BUNDLE))
    for name in BUNDLE_VARS:
        if name not in names:
            env.append(f"{name}={CONTAINER_BUNDLE}")
            continue
        path = env[names[name]].split("=", 1)[1]
        if path != CONTAINER_BUNDLE and not merged_bundle(bundle, rootfs, path, mounts):
            env[names[name]] = f"{name}={CONTAINER_BUNDLE}"

    if os.path.isfile(STORE):
        mounts.append(mount(STORE, CONTAINER_STORE))
        if JAVA_VAR in names:
            i = names[JAVA_VAR]
            env[i] = f"{JAVA_VAR}={with_java_options(env[i].split('=', 1)[1])}"
        else:
            env.append(f"{JAVA_VAR}={with_java_options(None)}")


def edit(bundle):
    """Edits the bundle's config.json in place, by replacing it with an edited copy."""
    path = os.path.join(bundle, "config.json")
    with open(path) as file:
        config = json.load(file)
    trust_ca(config, bundle)
    with open(path + ".firebrick", "w") as file:
        json.dump(config, file)
    os.replace(path + ".firebrick", path)


def main():
    args = sys.argv[1:]
    bundle = bundle_dir(args)
    if bundle is not None and os.path.isfile(CA) and os.path.isfile(BUNDLE):
        try:
            edit(bundle)
        except (OSError, ValueError, AttributeError, TypeError) as err:
            print(f"firebrick-runc: the container doesn't trust the TLS interception CA: {err}",
                  file=sys.stderr)
    os.execv(RUNC, [RUNC] + args)


main()
