---
import "../styles/global.css";
import "../styles/landing.css";
import CallToAction from "../components/landing/CallToAction.astro";
import Documentation from "../components/landing/Documentation.astro";
import Hero from "../components/landing/Hero.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import SiteFooter from "../components/landing/SiteFooter.astro";
import SiteHeader from "../components/landing/SiteHeader.astro";
import WhyFirebrick from "../components/landing/WhyFirebrick.astro";
import { withBase } from "../site";

const title = "Firebrick — a microVM sandbox for coding agents";
const description =
  "Firebrick runs local coding agents inside lightweight microVMs, so you can let them work without handing them your machine.";
// Link previews need absolute URLs.
const url = new URL(withBase(""), Astro.site).href;
const image = new URL(withBase("social-card.png"), Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Firebrick" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Firebrick: a fireproof room for your coding agent."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
  </head>
  <body class="bg-ink font-sans text-text-on-dark antialiased [&_code]:rounded [&_code]:bg-white/10 [&_code]:px-1 [&_code]:font-mono [&_code]:text-white">
    <SiteHeader />
    <main>
      <Hero />
      <WhyFirebrick />
      <HowItWorks />
      <Documentation />
      <CallToAction />
    </main>
    <SiteFooter />
  </body>
</html>
