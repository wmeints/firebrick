---
import "../styles/global.css";
import "../styles/landing.css";
import CallToAction from "../components/landing/CallToAction.astro";
import Documentation from "../components/landing/Documentation.astro";
import Hero from "../components/landing/Hero.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import SiteFooter from "../components/landing/SiteFooter.astro";
import SiteHeader from "../components/landing/SiteHeader.astro";
import WhyFirebrick from "../components/landing/WhyFirebrick.astro";
import { withBase } from "../site";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Firebrick — a microVM sandbox for coding agents</title>
    <meta
      name="description"
      content="Firebrick runs local coding agents inside lightweight microVMs, so you can let them work without handing them your machine."
    />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
  </head>
  <body class="bg-ink font-sans text-text-on-dark antialiased [&_code]:rounded [&_code]:bg-white/10 [&_code]:px-1 [&_code]:font-mono [&_code]:text-white">
    <SiteHeader />
    <main>
      <Hero />
      <WhyFirebrick />
      <HowItWorks />
      <Documentation />
      <CallToAction />
    </main>
    <SiteFooter />
  </body>
</html>
