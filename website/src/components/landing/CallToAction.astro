---
import Button from "../Button.astro";
import { docsPage, links } from "../../site";

const quickstart = docsPage("docs/quickstart");
---

<section
  aria-labelledby="cta-heading"
  class="mx-auto max-w-landing px-4 pb-16 sm:px-6 lg:pb-24"
>
  <div class="flex flex-col gap-8 rounded-card bg-brick px-6 py-10 sm:px-12 sm:py-14 lg:flex-row lg:items-center lg:justify-between">
    <div>
      <h2
        id="cta-heading"
        class="font-display text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-4xl"
      >
        Ready to put your agent in a sandbox?
      </h2>
      <p class="mt-3 text-white/85">
        Install fbk and start your first microVM with the Quickstart.
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <Button href={quickstart.href} variant="light">
        Read the Quickstart
      </Button>
      <Button href={links.repository} variant="outline">
        View on GitHub
      </Button>
    </div>
  </div>
</section>
