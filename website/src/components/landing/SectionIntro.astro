---
/** The eyebrow, heading and lead paragraph that open a landing page section. */
interface Props {
  eyebrow: string;
  heading: string;
  id: string;
}

const { eyebrow, heading, id } = Astro.props;
---

<p class="font-mono text-xs font-medium tracking-widest text-accent-dark uppercase">
  {eyebrow}
</p>
<h2
  id={id}
  class="mt-4 max-w-2xl font-display text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-4xl"
>
  {heading}
</h2>
{Astro.slots.has("default") && (
  <p class="mt-4 max-w-2xl text-muted-on-dark">
    <slot />
  </p>
)}
