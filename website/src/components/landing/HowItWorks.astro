---
import SectionIntro from "./SectionIntro.astro";

const steps = [
  {
    title: "Point it at a project",
    body: "Run <code>fbk start</code> from your project folder. Firebrick mounts that folder — and nothing else — into the sandbox.",
  },
  {
    title: "Firebrick boots a microVM",
    body: "microsandbox starts a lightweight VM with its own kernel and filesystem, walled off from your host.",
  },
  {
    title: "Your agent gets to work",
    body: "The agent runs inside the VM with exactly the access you granted. When it's done, review its changes in your own editor.",
  },
];
---

<section aria-labelledby="how-heading" class="bg-ink-raised">
  <div class="mx-auto max-w-landing px-4 py-16 sm:px-6 lg:py-24">
    <SectionIntro
      id="how-heading"
      eyebrow="How it works"
      heading="From project folder to sealed sandbox in one command."
    />
    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {steps.map((step, index) => (
        <li class="border-t border-card-border pt-6">
          <p class="font-mono text-xs text-accent-dark">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-3 font-display text-xl font-bold text-white">
            {step.title}
          </h3>
          <p class="mt-3 text-sm text-muted-on-dark" set:html={step.body} />
        </li>
      ))}
    </ol>
  </div>
</section>
