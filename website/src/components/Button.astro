---
/** A link styled as a button: brick, outlined on dark, or white on brick. */
interface Props {
  href: string;
  variant: "primary" | "outline" | "light";
}

const { href, variant } = Astro.props;

const variants = {
  primary: "bg-brick text-white hover:bg-accent-light",
  outline: "border border-white/25 text-white hover:border-white/60",
  light: "bg-white text-accent-light hover:bg-paper",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center gap-2 rounded-button px-5 py-3 text-sm font-semibold no-underline transition-colors",
    variants[variant],
  ]}
>
  <slot />
</a>
