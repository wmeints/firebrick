# The inputs of the Windows runtime that fbkd embeds (ADR 0061). build-kernel.sh and
# build-runtime.ps1 read this file; keep it KEY=value without quotes.
#
# Update all of them together when Cargo.lock moves to another microsandbox version: a unit test in
# crates/daemon/src/runtime.rs fails until MICROSANDBOX_VERSION matches it.

# The microsandbox release whose msb.exe the runtime pairs with our libkrunfw.dll.
MICROSANDBOX_VERSION=0.7.14
# SHA-256 of msb-windows-x86_64.exe in that release.
MSB_EXE_SHA256=3b828d85a5168988ac0d3989614a798d79e75268758147f0b2d85301acef8987

# The libkrunfw fork commit microsandbox builds that release from: the vendor/libkrunfw submodule
# of its tag. windows-netfilter.patch applies to its config-libkrunfw-windows_x86_64.
LIBKRUNFW_REPO=https://github.com/superradcompany/libkrunfw.git
LIBKRUNFW_COMMIT=223f11693774646eaa8ba892e3a6ebd07653154b
# LIBKRUNFW_ABI in microsandbox-utils; libkrunfw.dll reports it through krunfw_get_version.
LIBKRUNFW_ABI=5

# The container the kernel builds in: ubuntu:24.04, pinned to its multi-platform index.
BUILD_IMAGE=ubuntu:24.04@sha256:78d4744ead1f5b19b04d0df558ab182a5300903900755e515b2ca4d10eb2044d
